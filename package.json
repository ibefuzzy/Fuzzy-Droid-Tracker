{
    "name":  "fuzzys-droid-tracker",
    "version":  "1.19.0",
    "description":  "Fuzzy\u0027s Droid Tracker — a Droid Tycoon rebirth tracker with an always-on-top requirements HUD",
    "main":  "main.js",
    "author":  "Fuzzy",
    "private":  true,
    "scripts":  {
                    "start":  "electron .",
                    "test":  "node --test \"test/**/*.test.js\"",
                    "dist":  "electron-builder"
                },
    "dependencies":  {
                         "@tesseract.js-data/eng":  "1.0.0",
                         "puppeteer":  "^25.12.0",
                         "sharp":  "^0.35.4",
                         "tesseract.js":  "^5.1.0",
                         "tesseract.js-core":  "5.1.1"
                     },
    "devDependencies":  {
                            "electron":  "^44.5.1",
                            "electron-builder":  "^25.0.0"
                        },
    "build":  {
                  "appId":  "com.fuzzy.droidtracker",
                  "productName":  "Fuzzy\u0027s Droid Tracker",
                  "directories":  {
                                      "output":  "release"
                                  },
                  "files":  [
                                "**/*",
                                "!_orig.html",
                                "!dist/**",
                                "!release/**",
                                "!safe-to-retire-icons/**",
                                "!safe-to-retire-icons*.zip",
                                "!src/**",
                                "!test/**",
                                "!worker/**",
                                "!.claude/**",
                                "!CLAUDE.md",
                                "!.gitignore",
                                "!build-log.txt",
                                "!build-release.bat",
                                "!gh-check.*",
                                "!droid-cards/**",
                                "!droidex-card-screenshots/**",
                                "!droid-data-external/**",
                                "!card-full-data.js",
                                "!extract-droid-cards.js",
                                "!build-card-icons.js",
                                "!build-kyber-card-icons.js",
                                "!build-missing-card-icons.js",
                                "!icons-data.js",
                                "!build-sound-data.js",
                                "!sounds/*.mp3",
                                "!DROID IMAGES*.png",
                                "!dev/**",
                                "!.ignore",
                                "!_backup*/**",
                                "!*.md",
                                "!build-output.txt",
                                "!exe-sha256.txt",
                                "!droid-data.backup.js",
                                "!*.traineddata",
                                "!scrape-droidex-cards.js",
                                "!capture-droid-variants.js",
                                "!scrape-droidex.js",
                                "!DROIDEX_IMAGE_IMPORT_GUIDE.md",
                                "!node_modules/**",
                                "node_modules/tesseract.js/LICENSE.md",
                                "node_modules/tesseract.js/dist/tesseract.min.js",
                                "node_modules/tesseract.js/dist/tesseract.min.js.LICENSE.txt",
                                "node_modules/tesseract.js/dist/worker.min.js",
                                "node_modules/tesseract.js/dist/worker.min.js.LICENSE.txt",
                                "node_modules/tesseract.js-core/tesseract-core-simd-lstm.wasm.js",
                                "node_modules/tesseract.js-core/tesseract-core-lstm.wasm.js",
                                "node_modules/tesseract.js-core/LICENSE",
                                "node_modules/@tesseract.js-data/eng/4.0.0_best_int/eng.traineddata.gz",
                                "node_modules/@tesseract.js-data/eng/README.md",
                                "fonts/**"
                            ],
                  "electronLanguages":  [
                                            "en-US"
                                        ],
                  "win":  {
                              "target":  "portable"
                          },
                  "mac":  {
                              "target":  "dmg"
                          },
                  "linux":  {
                                "target":  "AppImage"
                            }
              }
}
